# Заполните токен и ID только у себя на компьютере, не публикуйте их в GitHub.
# Рекомендуется хранить секреты в .env.local (этот файл исключён из Git).
BOT_TOKEN=
# Telegram ID администраторов через запятую. Узнать свой ID: /myid
ADMIN_IDS=

# Кнопки анкеты
BUTTON_PHONE=Отправить телефон
BUTTON_NEXT=Далее

# Кнопки основного меню
BUTTON_BREAKDOWN=Поломка
BUTTON_BOOKING=Запись
BUTTON_CONTACTS=Контакты
BUTTON_REVIEWS=Отзывы

# Кнопки админ-панели и переходов
BUTTON_ADMIN_VISITS=Кто и когда заходил
BUTTON_ADMIN_REQUESTS=Заявки и телефоны
BUTTON_DELETE_REQUEST=Удалить заявку
BUTTON_CONFIRM_DELETE=Да, удалить
BUTTON_CANCEL_DELETE=Отмена
BUTTON_BACK=← Назад
BUTTON_FORWARD=Далее →
BUTTON_OPEN_REVIEWS=Открыть отзывы
BUTTON_CHANGE_DATE=Выбрать другую дату

# Команда входа в админ-панель: /admin
# Команда начала анкеты клиента: /start
CONTACTS_TEXT=БытТех — самозанятый мастер, Самара. Телефон: +7 (905) 303-15-51. Приём заявок ежедневно 08:00–20:00.
REVIEWS_TEXT=Отзывы пока не добавлены.
REVIEWS_URL=
DATABASE_PATH=data/bot.sqlite3
WELCOME_PHOTO=assets/welcome.png

# Заявки с сайта: включите на сервере, где работает этот бот.
WEB_ENABLED=0
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Замените на точные адреса опубликованного сайта, через запятую.
WEB_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Доверять X-Real-IP только от своего reverse proxy; заголовок должен перезаписываться.
WEB_TRUSTED_PROXIES=127.0.0.1/32,::1/128


# ОБЯЗАТЕЛЬНО перед WEB_ENABLED=1: подтверждённые реквизиты исполнителя.
# Персональные данные владельца не вносить в отслеживаемый .env/.env.example!
# Заполните ТОЛЬКО приватный .env.local / переменные среды на VPS.
WEB_OWNER_FULL_NAME=
WEB_OWNER_INN=
WEB_OWNER_ADDRESS=
WEB_CONTACT_PHONE=+79053031551
WEB_CONTACT_EMAIL=
# 1 — владелец ознакомился и подтвердил опубликованный прайс и скидки.
WEB_SITE_PRICES_CONFIRMED=0
# 1 — хранение БД и первичная запись данных РФ реально организованы в РФ.
WEB_DATA_STORAGE_RU_CONFIRMED=0
# 1 — проверены правовое основание, уведомление РКН и риски
# передачи телефонов/имён через Telegram, включая статью 12 ФЗ-152.
WEB_TELEGRAM_TRANSFER_REVIEWED=0
