# Заполните токен и ID только у себя на компьютере, не публикуйте их в GitHub.
# Рекомендуется хранить секреты в .env.local (этот файл исключён из Git).
BOT_TOKEN=
# Telegram ID администраторов через запятую. Узнать свой ID: /myid
ADMIN_IDS=

# Кнопки анкеты
BUTTON_PHONE=Отправить телефон
BUTTON_NEXT=Далее

# Кнопки основного меню
BUTTON_BREAKDOWN=Поломка
BUTTON_BOOKING=Запись
BUTTON_CONTACTS=Контакты
BUTTON_REVIEWS=Отзывы

# Кнопки админ-панели и переходов
BUTTON_ADMIN_VISITS=Кто и когда заходил
BUTTON_ADMIN_REQUESTS=Заявки и телефоны
BUTTON_BACK=← Назад
BUTTON_FORWARD=Далее →
BUTTON_OPEN_REVIEWS=Открыть отзывы

# Команда входа в админ-панель: /admin
# Команда начала анкеты клиента: /start
CONTACTS_TEXT=Контакты сервиса пока не заполнены.
REVIEWS_TEXT=Отзывы пока не добавлены.
REVIEWS_URL=
DATABASE_PATH=data/bot.sqlite3
WELCOME_PHOTO=assets/welcome.png
