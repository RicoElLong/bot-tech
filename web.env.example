# Копируйте нужные строки в .env.local НА СЕРВЕРЕ. Не публикуйте заполненные значения.
# BOT_TOKEN и ADMIN_IDS используются из настроек существующего бота.
WEB_FORM_ENABLED=false
WEB_SITE_ORIGIN=https://ricoellong.github.io
# HTTPS-адрес будущего API, например https://forms.your-domain.ru. Пока оставить пустым.
WEB_API_PUBLIC_URL=
# Полное ФИО самозанятого/ИП или название юрлица, адрес для обращений, email.
WEB_OPERATOR_NAME=
WEB_OPERATOR_ADDRESS=
WEB_OPERATOR_EMAIL=
# ru — только ПОСЛЕ проверки фактического размещения базы и обработки в России.
WEB_DATA_LOCATION_CONFIRMED=
WEB_DATABASE_PATH=data/web-leads.sqlite3
WEB_ADMIN_USER=admin
# Случайный пароль длиной не менее 20 символов, НЕ токен Telegram.
WEB_ADMIN_PASSWORD=
